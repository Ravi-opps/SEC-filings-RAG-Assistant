# Copy this file to .env and fill in real values. Never commit .env.
# The SEC pipeline needs no keys; these are for the model gateway.

# Postgres users + auth (these defaults match docker-compose.yml)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# JWT: set JWT_SECRET to your own random value (32+ bytes). Never commit it.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LangSmith tracing
LANGSMITH_TRACING=
LANGSMITH_API_KEY=

# Provider keys
OPENROUTER=
GEMINI=
MISTRAL=
GROQ=

# OpenAI-compatible gateway: model keys and endpoints
OPENAI_LUNA=
OPENAI_SOL=
SOL_URL=
OPENAI_EMBEDDINGS=
EMBED_URL=
OPENAI_ENDPT=
EMBED_MODEL=text-embedding-3-large
CLASSIFIER_URL=
CLASSIFIER_NAME=gpt-5.4-pro
CLASSIFIER_KEY=
RERANK_URL=
RERANK_KEY=
RERANK_MODEL=
GROQ_URL=
GROQ_GUARDRAIL_MODEL=openai/gpt-oss-120b

# Qdrant (used by processor.py / index_filing.py)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_API=
QDRANT_COLLECTION=sec_sentences

# Redis cache: ticker -> {company, cik, year}
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=604800

# Kafka job queue (cluster "RAG")
# loader consumes KAFKA_TOPIC; loader publishes to KAFKA_STEP2_TOPIC for "step2"
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sec-filings
KAFKA_STEP2_TOPIC=sec-filings-index
KAFKA_GROUP_ID=loader
KAFKA_STEP2_GROUP_ID=step2
KAFKA_MAX_POLL_INTERVAL_MS=1800000

# Step-2 chunk worker (process pool)
CHUNK_PROCESSES=3
CHUNK_EMBED_BATCH_SIZE=32
CHUNK_UPLOAD_BATCH_SIZE=32
CHUNK_POLL_TIMEOUT_MS=1000
CHUNK_MAX_RETRIES=3
CHUNK_RETRY_BACKOFF_SECONDS=5
CHUNK_TTL_SECONDS=604800

# Loader terminal UI: set to 1 to disable the in-place progress line
NO_PROGRESS=0
